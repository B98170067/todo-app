# App Settings：
PORT=3000
NODE_ENV=development

# JWT Configuration：
# 用 Node.js 產生一組密鑰：node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your-jwt-secret
JWT_EXPIRES_IN=1d

# MongoDB Configuration：
MONGO_URI=mongodb://localhost:27017/todo_dev

# CORS Settings：
CORS_ORIGIN=http://localhost:5173
